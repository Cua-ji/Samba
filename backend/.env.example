PORT=3001
# Conexion PostgreSQL en Supabase (recomendado usar Session Pooler para IPv4)
DATABASE_URL=postgresql://postgres.jkfewzdudclwndkyobac:[TU-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Opcional: forzar SSL (se activa automaticamente para conexiones no locales)
# DATABASE_SSL=true

# Proveedor LLM: 'ollama' (local en GPU), 'auto', 'gemini', 'openai' o 'fallback'
LLM_PROVIDER=ollama

# Ollama Local o Compartido en Red (cambia 127.0.0.1 por la IP/Tailscale del equipo con Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Fuente externa de nutricion (USDA FoodData Central)
USDA_API_KEY=DEMO_KEY

# Google Gemini API (Opcional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API (Opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
