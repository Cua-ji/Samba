PORT=3001
# Conexion PostgreSQL en Docker Desktop
DATABASE_URL=postgresql://samba:samba_secret@localhost:5432/samba_db

# Proveedor LLM: 'ollama' (local en GPU), 'auto', 'gemini', 'openai' o 'fallback'
LLM_PROVIDER=ollama

# Ollama Local (Windows / Docker)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Fuente externa de nutricion (USDA FoodData Central)
USDA_API_KEY=DEMO_KEY

# Google Gemini API (Opcional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API (Opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
